# =============================================================================
# business-client — Next.js host/venue dashboard (default port: 3000)
# =============================================================================
# Copy to `.env` (or `.env.local`) and fill in. Restart `next dev` after edits.

# ---- main-server API --------------------------------------------------------
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:4000

# ---- Public site URL (used in OG tags, transactional email links) -----------
# Set to the deployed origin in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Symmetric encryption (must match main-server) --------------------------
# Browser-side key used to encrypt sensitive form fields before submit.
# Same value as main-server's CLIENT_ENCRYPTION_KEY.
NEXT_PUBLIC_ENCRYPTION_KEY=

# Server-side key for /api/* routes that HMAC-sign payloads going to
# main-server. Same value as main-server's ENCRYPTION_KEY.
ENCRYPTION_KEY=

# ---- Cloudinary (browser uploads of event flyers, venue logos, etc.) --------
NEXT_PUBLIC_HOIZR_ENV=dev
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_IMAGE_PRESET=hoizr-uploads
NEXT_PUBLIC_CLOUDINARY_RAW_PRESET=hoizr-uploads-raw

# ---- Resend (contact-form + waitlist email relay) ---------------------------
# Server-side only (used in /api/* routes). Generate at https://resend.com
RESEND_API_KEY=
WAITLIST_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=

# ---- Support contact --------------------------------------------------------
# WhatsApp number used by the venue-onboarding helper rail "Start a chat"
# link. Numeric only (no + or spaces). Defaults to 8369572945 if unset.
NEXT_PUBLIC_HOIZR_WHATSAPP=8369572945

# ---- PostHog product analytics ----------------------------------------------
# Project token is write-only — safe to commit / expose in browser bundles.
NEXT_PUBLIC_POSTHOG_KEY=<your-posthog-project-key>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
